{
  "manifest_version": 3,
  "name": "AI Market Discover",
  "version": "1.0.0",
  "description": "AI powered financial dashboard",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-inline' 'unsafe-eval'; object-src 'self'; connect-src *;"
  }
}